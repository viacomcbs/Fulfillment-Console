<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Orders left filters — 5 filters (People & distribution metadata), 1 Synergy login.
     Group: ownership (Submitted By, Assigned To) + distribution (Brand, Partner, Content type).
     Manage columns once for all 5 columns before any filter scenarios.
     Flow per filter: Basic → Option order → Scroll → Search → Collapse → Table sync → Active → Clear → Select all.
     Between filters: browser refresh + verify Clear filters is not active.
     Maven: mvn test "-DsuiteXmlFile=src/test/resources/regression/left-filters/orders-view/sessions/LF_O_PeopleDistribution_5filters_ProdServerSuite.xml" -->
<suite name="LF Orders People Distribution 5 Filters PROD" parallel="false" preserve-order="true">
  <parameter name="RunAsFactory" value="false"/>
  <parameter name="Browser" value="Chrome"/>
  <parameter name="OS" value="Windows"/>
  <parameter name="OSVersion" value="11"/>
  <parameter name="DeviceCategory" value="Desktop"/>
  <parameter name="TestType" value="Regression"/>
  <parameter name="GuiType" value="Web"/>
  <parameter name="SendReportAutoEmails" value="false"/>
  <parameter name="SendChatReport" value="false"/>
  <parameter name="LeftFilterEmailReport" value="true"/>
  <parameter name="LeftFilterBatchMode" value="true"/>
  <parameter name="LeftFilterEmailSuiteTitle" value="Orders Tab - Left Filters (PROD) - People &amp; Distribution (5 filters)"/>
  <parameter name="AggregateResultsDir" value="test-output/lf-o-5filter-people-distribution-aggregate"/>

  <parameter name="Application" value="Fulfillment Console"/>
  <parameter name="ApplicationTitle" value="Fulfillment Console"/>
  <parameter name="TestEnvironment" value="PROD"/>

  <parameter name="LabUrl" value="https://www.synergyserver.tech"/>
  <parameter name="UserKey" value="af27f06e-2e7e-4c8d-9312-2320423e4641"/>
  <parameter name="LocalURL" value="http://localhost:39445/synergy"/>
  <parameter name="LocalExecution" value="false"/>
  <parameter name="ClientID" value="5CG23257SH"/>

  <parameter name="TargetUrlDEV" value="https://dev-operationsconsole.paramountmsc.com/fulfillment/"/>
  <parameter name="TargetUrlUAT" value="https://uat-operationsconsole.paramountmsc.com/fulfillment/"/>
  <parameter name="TargetUrlPROD" value="https://operationsconsole.paramountmsc.com/fulfillment/"/>

  <parameter name="Username" value=""/>
  <parameter name="Password" value=""/>

  <parameter name="PathToElements" value="/src/test/resources/elements/"/>
  <parameter name="PageLoadWaitTime" value="120"/>
  <parameter name="EmailSenderAddress" value="NOREPLY@dteqa.com"/>

  <listeners>
    <listener class-name="com.paramount.test.ff.common.listeners.AllureListeners"/>
    <listener class-name="com.paramount.test.ff.common.listeners.SuiteListeners"/>
    <listener class-name="com.paramount.test.ff.common.listeners.LeftFilterSuiteListener"/>
  </listeners>

  <test verbose="1" name="5-filter batch — People &amp; distribution metadata" preserve-order="true">
    <classes>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.LF_O_Batch5Filters_ManageColumnsSetupTest">
        <methods>
          <include name="setup_manageColumnsPeopleAndDistributionBatch"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.submittedby.LF_O_BatchFlow_SubmittedByTest">
        <methods>
          <include name="batchFlow_submittedByAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.assignedto.LF_O_BatchFlow_AssignedToTest">
        <methods>
          <include name="batchFlow_assignedToAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.brand.LF_O_BatchFlow_BrandTest">
        <methods>
          <include name="batchFlow_brandAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.partner.LF_O_BatchFlow_PartnerTest">
        <methods>
          <include name="batchFlow_partnerAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.contenttype.LF_O_BatchFlow_ContentTypeTest">
        <methods>
          <include name="batchFlow_contentTypeAllScenarios"/>
        </methods>
      </class>
    </classes>
  </test>
</suite>

            <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.submittedby.LF_O_TC106_SubmittedBy_OptionOrderTest">
                <methods><include name="tc106_submittedByOptionOrder"/></methods>
            </class>
            <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.submittedby.LF_O_TC1105_SubmittedBy_ClearFiltersTest">
                <methods><include name="tc1105_submittedByClearFilters"/></methods>

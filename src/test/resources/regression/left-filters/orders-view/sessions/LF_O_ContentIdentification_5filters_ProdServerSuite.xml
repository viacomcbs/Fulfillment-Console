<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!-- Orders left filters — 5 filters (Content identification), 1 Synergy login.
     Group: Series title, Season number, Episode number | Language, Franchise.
     Manage columns once for Title Season Episode + Language before any filter scenarios.
     Flow per filter: Basic → Option order → Scroll → Search → Collapse → Table sync → Active → Clear → Select all.
     Between filters: browser refresh + verify Clear filters is not active.
     Maven: mvn test "-DsuiteXmlFile=src/test/resources/regression/left-filters/orders-view/sessions/LF_O_ContentIdentification_5filters_ProdServerSuite.xml" -->
<suite name="LF Orders Content Identification 5 Filters PROD" parallel="false" preserve-order="true">
  <parameter name="RunAsFactory" value="false"/>
  <parameter name="Browser" value="Chrome"/>
  <parameter name="OS" value="Windows"/>
  <parameter name="OSVersion" value="11"/>
  <parameter name="DeviceCategory" value="Desktop"/>
  <parameter name="TestType" value="Regression"/>
  <parameter name="GuiType" value="Web"/>
  <parameter name="SendReportAutoEmails" value="false"/>
  <parameter name="SendChatReport" value="false"/>
  <parameter name="LeftFilterEmailReport" value="true"/>
  <parameter name="LeftFilterBatchMode" value="true"/>
  <parameter name="LeftFilterEmailSuiteTitle" value="Orders Tab - Left Filters (PROD) - Content Identification (5 filters)"/>
  <parameter name="AggregateResultsDir" value="test-output/lf-o-5filter-content-identification-aggregate"/>

  <parameter name="Application" value="Fulfillment Console"/>
  <parameter name="ApplicationTitle" value="Fulfillment Console"/>
  <parameter name="TestEnvironment" value="PROD"/>

  <parameter name="LabUrl" value="https://www.synergyserver.tech"/>
  <parameter name="UserKey" value="af27f06e-2e7e-4c8d-9312-2320423e4641"/>
  <parameter name="LocalURL" value="http://localhost:39445/synergy"/>
  <parameter name="LocalExecution" value="false"/>
  <parameter name="ClientID" value="5CG23257SH"/>

  <parameter name="TargetUrlDEV" value="https://dev-operationsconsole.paramountmsc.com/fulfillment/"/>
  <parameter name="TargetUrlUAT" value="https://uat-operationsconsole.paramountmsc.com/fulfillment/"/>
  <parameter name="TargetUrlPROD" value="https://operationsconsole.paramountmsc.com/fulfillment/"/>

  <parameter name="Username" value=""/>
  <parameter name="Password" value=""/>

  <parameter name="PathToElements" value="/src/test/resources/elements/"/>
  <parameter name="PageLoadWaitTime" value="120"/>
  <parameter name="EmailSenderAddress" value="NOREPLY@dteqa.com"/>

  <listeners>
    <listener class-name="com.paramount.test.ff.common.listeners.AllureListeners"/>
    <listener class-name="com.paramount.test.ff.common.listeners.SuiteListeners"/>
    <listener class-name="com.paramount.test.ff.common.listeners.LeftFilterSuiteListener"/>
  </listeners>

  <test verbose="1" name="5-filter batch — Content identification" preserve-order="true">
    <classes><class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.seasonnumber.LF_O_BatchFlow_SeasonNumberTest">
        <methods>
          <include name="batchFlow_seasonNumberAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.episodenumber.LF_O_BatchFlow_EpisodeNumberTest">
        <methods>
          <include name="batchFlow_episodeNumberAllScenarios"/>
        </methods>
      </class>
      <class name="com.paramount.test.ff.uitests.tests.leftfiltersvalidation.perfilter.orders.language.LF_O_BatchFlow_LanguageTest">
        <methods>
          <include name="batchFlow_languageAllScenarios"/>
        </methods>
      </class>
      </classes>
  </test>
</suite>
